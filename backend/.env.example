# Copy to .env and fill in. NEVER commit .env.
PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=sahajjo_app
DB_PASSWORD=change_me
DB_NAME=sahajjo

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15

GEMINI_API_KEY=

# S3-Compatible Object Storage (SeaweedFS)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=sahajjo-documents
S3_ACCESS_KEY=sahajjo_s3_key
S3_SECRET_KEY=sahajjo_s3_secret_2026
S3_FORCE_PATH_STYLE=true
